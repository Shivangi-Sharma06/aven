# Optional locations for the lightweight local work-session stores.
AVEN_SESSION_STORE=./data/work-sessions.json
AVEN_CLI_TOKEN_STORE=./data/cli-tokens.json

# Required in production. Shared persistence makes work sessions and CLI
# authorizations available across devices and serverless instances.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Optional explicit namespace. Defaults to NEXT_PUBLIC_STREAM_CONTRACT_ID so a
# fresh contract deployment starts with an empty application data set.
AVEN_DATA_NAMESPACE=

# ─── Stellar Network (testnet defaults, override for mainnet) ──────────────────
# For mainnet, set these:
#   NEXT_PUBLIC_SOROBAN_RPC_URL=https://soroban-rpc.mainnet.stellar.org
#   NEXT_PUBLIC_HORIZON_URL=https://horizon.stellar.org
#   NEXT_PUBLIC_NETWORK_PASSPHRASE=Public Global Stellar Network ; September 2015
#   NEXT_PUBLIC_NETWORK_LABEL=Stellar Mainnet
#   NEXT_PUBLIC_STELLAR_EXPLORER=https://stellar.expert/explorer/public

# Contract IDs (mainnet values shown — override for testnet)
NEXT_PUBLIC_STREAM_CONTRACT_ID=CCPIESR7PCBANBQKBXEJSZQKPC3OKXCUBODOU7WSKTADYRRJVEGMKWCZ
NEXT_PUBLIC_ATTESTATION_CONTRACT_ID=CBSV5JBW62GX7FV2ORZIZSELMGFKB6V6HHZAM55YMMFSI72A5IML24N3
NEXT_PUBLIC_REPUTATION_CONTRACT_ID=CCYSWEVCNN7IT32FY4EBTSQWMRMATAHK3TGSSLAEILDAAGNDN3CQPCT2

# Asset IDs (mainnet values shown — override for testnet)
# Mainnet USDC issuer: GA5ZSEJYB37JRC5AVCIA5MOP4RHTM335X2KGX3IHOJAPP5RE34K4KZVN
# Mainnet USDC contract: CCW67TSZV3SSS2HXMBQ5JFGCKJNXKZM7UQUWUZPUTHXSTZLEO7SJMI75
NEXT_PUBLIC_USDC_ISSUER=GA5ZSEJYB37JRC5AVCIA5MOP4RHTM335X2KGX3IHOJAPP5RE34K4KZVN
NEXT_PUBLIC_USDC_ASSET_ID=CCW67TSZV3SSS2HXMBQ5JFGCKJNXKZM7UQUWUZPUTHXSTZLEO7SJMI75
NEXT_PUBLIC_XLM_ASSET_ID=CDLZFC3SYJYDZT7K67VZ75HPJVIEUVNIXF47ZG2FB2RMQQVU2HHGCYSC

# Server-only signer used to record verified work claims. Never expose this
# value through a NEXT_PUBLIC variable or commit a real secret.
AVEN_VERIFIER_SECRET=S...

# ─── GitHub App integration (server-only — never use NEXT_PUBLIC_) ───────────
# GitHub App numeric ID (visible on the App settings page).
GITHUB_APP_ID=
# RSA private key for the GitHub App. In single-line env vars, replace every
# literal newline with \n (the getGithubEnv() function normalises them).
GITHUB_APP_PRIVATE_KEY=
# Installation ID for the Aven org (visible under App > Installations).
GITHUB_APP_INSTALLATION_ID=
# Webhook secret configured in the GitHub App settings.
GITHUB_WEBHOOK_SECRET=
# The GitHub organisation under which project repositories are created.
GITHUB_AVEN_ORG=
# OAuth App client ID (for linking worker GitHub accounts).
GITHUB_OAUTH_CLIENT_ID=
# OAuth App client secret — never expose to the browser.
GITHUB_OAUTH_CLIENT_SECRET=
# OAuth redirect URI registered in the GitHub OAuth App settings.
# Production: https://your-domain.com/api/github/callback
# Local:      http://localhost:3000/api/github/callback
GITHUB_OAUTH_REDIRECT_URI=
